# Copy to docker/.env.vps on the VPS. Never commit the real file.
# This stack uses its OWN Postgres (docuengine). Do not point these at sonasu_pm.

DOCUENGINE_ENV=production
OCR_ENGINE=mock
TRAINING_ENABLED=false
RUN_SEED=1

# openssl rand -hex 32
SECRET_KEY=change-me
# openssl rand -hex 24
POSTGRES_PASSWORD=change-me-docuengine-db

POSTGRES_DB=docuengine
POSTGRES_USER=docuengine

SUPERADMIN_EMAIL=admin@sonasu.co.jp
SUPERADMIN_PASSWORD=change-me-on-first-login
SUPERADMIN_NAME=Sonasu Admin

# Host port — must NOT be 80 or 443 (Caddy / opervia.net). PM is :8100.
HTTP_PORT=8200
