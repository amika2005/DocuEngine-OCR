# --- Core ---
DOCUENGINE_ENV=development
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
API_BASE_URL=http://localhost:8000

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docuengine
POSTGRES_USER=docuengine
POSTGRES_PASSWORD=docuengine-dev-password

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Storage ---
DATA_DIR=./data

# --- OCR engine ---
# paddleocr-vl | ppocrv5-cpu | rapidocr | sonasu-ocr | mock
OCR_ENGINE=mock
MODELS_DIR=./models
# Office RapidOCR gateway (OCR_ENGINE=sonasu-ocr). Never put this key in the browser.
SONASU_OCR_BASE_URL=https://edge.sonasu.jp
SONASU_OCR_API_KEY=
SONASU_OCR_TIMEOUT_SECONDS=120
OCR_DPI=200
OCR_MAX_LONG_EDGE=2600

# --- Initial super admin (Sonasu), created by seed ---
SUPERADMIN_EMAIL=admin@sonasu.co.jp
SUPERADMIN_PASSWORD=change-me-on-first-login
SUPERADMIN_NAME=Sonasu Admin

# --- Auth ---
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Training ---
TRAINING_ENABLED=false
TRAINING_MIN_CORRECTIONS=200
TRAINING_SCHEDULE_HOUR_JST=2
TRAINING_WALL_CLOCK_HOURS=4

# --- Ingest backpressure ---
INGEST_MAX_QUEUE_DEPTH=2000
